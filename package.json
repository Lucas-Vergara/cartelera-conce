{
  "name": "cartelera-conce",
  "private": true,
  "version": "0.1.0",
  "description": "Todas las funciones de cine del Gran Concepción: cadenas, salas independientes y cineclubes.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "recolectar": "node recolector/index.js",
